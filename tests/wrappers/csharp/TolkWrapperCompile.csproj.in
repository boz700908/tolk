<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>TolkWrapperCompile</AssemblyName>
    <RootNamespace>DavyKager</RootNamespace>
